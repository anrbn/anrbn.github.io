---
interface Props {
  variant?: "home" | "rail";
}

const { variant = "home" } = Astro.props;
---

<div class:list={["site-identity", variant === "home" ? "home-identity" : "rail-identity"]}>
  <a class="site-mark" href="/" aria-label="Margin Notes home">anirban.cloud</a>
  <nav class="identity-social" aria-label="Social links">
    <a href="https://github.com/anrbn" target="_blank" rel="noreferrer" aria-label="GitHub">
      <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/github.svg" alt="" width="16" height="16" />
    </a>
    <a href="https://www.linkedin.com/in/anrbn/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
      <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/linkedin.svg" alt="" width="16" height="16" />
    </a>
    <a href="https://x.com/threatdefend" target="_blank" rel="noreferrer" aria-label="X">
      <img src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/x.svg" alt="" width="16" height="16" />
    </a>
  </nav>
</div>
