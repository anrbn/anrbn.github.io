---
interface Props {
  variant?: "home" | "article";
}

const { variant = "home" } = Astro.props;
---

<img
  class:list={["flower-decoration", variant === "article" && "article-flower"]}
  src="/new.png"
  alt=""
  aria-hidden="true"
  width="960"
  height="652"
  loading="eager"
  decoding="async"
/>
